# Web owner panel (run behind HTTPS reverse proxy)
ADMIN_PANEL_HOST=127.0.0.1
ADMIN_PANEL_PORT=8091
ADMIN_PANEL_PASSWORD=change_this_to_a_long_random_password
ADMIN_PANEL_SECRET=replace_with_a_long_random_secret
ENV_FILE_PATH=/opt/all-gptbot/.env
